# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Yalnızca sunucu tarafı: cron görevleri ve akademik birim senkronizasyonu.
# ASLA NEXT_PUBLIC_ ile başlatmayın. Eski projelerde SUPABASE_SERVICE_ROLE_KEY adı da kabul edilir.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel Cron ---
# /api/cron/* uçlarını korur; Vercel bu değeri Authorization başlığında gönderir.
CRON_SECRET=

# --- Şifre sıfırlama ---
# E-postadaki bağlantının döneceği adres (ör. https://panel.arvolab.com).
# Boş bırakılırsa istek başlıklarından türetilir. Supabase → Authentication →
# URL Configuration → Redirect URLs listesine <bu adres>/auth/confirm** eklenmelidir.
NEXT_PUBLIC_SITE_URL=

# --- AI geri bildirimi (Belge Kontrol) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ArvoOS köprüsü (bireysel abonelik) ---
# Kuruma bağlı olmayan kullanıcının aboneliği ArvoOS'ta tutulur; ArvoLab durumu
# oradan sorar ve ödeme bağlantısı ister (lib/subscription.ts). İkisi de boşsa
# köprü kapalıdır: kimse engellenmez, kişisel ödeme düğmesi gösterilmez.
ARVOOS_BRIDGE_URL=
# İki tarafta aynı olan paylaşılan gizli anahtar. ASLA NEXT_PUBLIC_ ile başlatmayın.
PRODUCT_BRIDGE_SECRET=
